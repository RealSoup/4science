<IfModule mod_headers.c>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 보안: index.php 외의 PHP 파일 실행 차단 (업로드 폴더 /storage, /js 등에 올라온 웹셸 대응, 2026-10)
    RewriteCond %{REQUEST_URI} !^/index\.php$ [NC]
    RewriteRule \.(php[0-9]?|phtml|phar|pht|phps|inc)$ - [F,L,NC]
    
    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # 정적 자산이 실제로 없을 때만 404 (있으면 그냥 통과)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_URI} ^/(js|css|img|fonts)/ [NC]
    RewriteRule ^ - [L,R=404]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]

    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [R=301,QSA,NC,L]

    php_value max_execution_time -1
</IfModule>5666회  147.45.47.119  GET /etc/imageview.php?src=item%2Fgalaxy%20use.jpg
